# Environment: local | dev | test | production
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=django-insecure-template-secret-key-change-in-production-abcdef123456

# Allowed hosts & CORS (comma-separated strings or JSON lists)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
# In Docker Compose, POSTGRES_HOST is 'db'
POSTGRES_DB=django_api_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set to True for running locally with SQLite without needing PostgreSQL
USE_SQLITE=False

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
